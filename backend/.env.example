# Copy to .env.runtime; never overwrite an existing .env or dataset.
# Required: obtain an approved, already-migrated SQLite + matching media bundle.
DATABASE_URL=sqlite:////absolute/path/to/approved/database.sqlite3
LOCAL_IMAGE_DIR=/absolute/path/to/approved/media
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8006
API_PREFIX=/api/v1
ENABLE_INFERENCE_MEDIA_MIGRATION=false
AI_SERVICE_URL=http://127.0.0.1:8004
AI_SERVICE_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for BE-04 Worker / optional cloud proxy; never EXPO_PUBLIC/VITE.
SUPABASE_KEY=
BE04_CLOUD_READ_ENABLED=false
BE04_FARM_ID=
BE04_OWNER_USER_ID=
# Add Device / Purge write to Supabase first (needs SUPABASE_KEY). Keep false until the
# cloud devices.device_code UNIQUE constraint exists. See docs/DEVICE_MANAGEMENT_API.md.
DEVICE_CLOUD_WRITE_ENABLED=false
DEVICE_OFFLINE_THRESHOLD_MINUTES=15
CAPTURE_ADAPTER_MODE=unconfigured
# Server/Pi only. Never expose to Web/Mobile.
HARDWARE_API_KEY=fmW_dJB5LWkfi2PVsIg5VXo6LO_dfJ8Ivs168KxNhgg
MAX_DETECTION_IMAGE_BYTES=10485760
