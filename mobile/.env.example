EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local or cloud. Quick Detection ALWAYS needs the Backend, including in cloud mode.
EXPO_PUBLIC_DATA_SOURCE=local
# Replace YOUR_MAC_LAN_IP; localhost on an iPhone is the iPhone itself.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_MAC_LAN_IP:8006
